{
  "name": "@coslate/core",
  "version": "0.2.3",
  "description": "CoSlate core: the scene model, command protocol, undo history, viewport math and serialization. Zero runtime dependencies, no DOM.",
  "license": "MIT",
  "author": "CoSlate contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denniste/coslate.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/denniste/coslate#readme",
  "bugs": {
    "url": "https://github.com/denniste/coslate/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "!dist/*.tsbuildinfo"
  ],
  "keywords": [
    "whiteboard",
    "canvas",
    "scene-graph",
    "undo",
    "json-patch",
    "coslate"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -b ."
  }
}
