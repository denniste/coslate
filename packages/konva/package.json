{
  "name": "@coslate/konva",
  "version": "0.2.0",
  "description": "CoSlate Konva renderer and editing tools. Renders a scene; never owns it.",
  "license": "MIT",
  "author": "CoSlate contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denniste/coslate.git",
    "directory": "packages/konva"
  },
  "homepage": "https://github.com/denniste/coslate#readme",
  "bugs": {
    "url": "https://github.com/denniste/coslate/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "!dist/*.tsbuildinfo"
  ],
  "keywords": [
    "whiteboard",
    "konva",
    "canvas",
    "renderer",
    "coslate"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -b ."
  },
  "dependencies": {
    "konva": "^9.3.16"
  },
  "peerDependencies": {
    "@coslate/core": "^0.2.0"
  },
  "devDependencies": {
    "@coslate/core": "workspace:*"
  }
}
