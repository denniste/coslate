{
  "name": "@coslate/demo",
  "version": "0.1.0",
  "private": true,
  "description": "CoSlate demo: an editor page and a read-only viewer page, built with vanilla TypeScript + Vite on @coslate/core, @coslate/konva and @coslate/ui.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview --port 4321 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@coslate/core": "workspace:*",
    "@coslate/konva": "workspace:*",
    "@coslate/ui": "workspace:*",
    "konva": "^9.3.16"
  }
}
